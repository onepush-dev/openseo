# Every variable in the template, with the value the template sets.
# Generated secrets use Railway template functions; cross-service values use references.

########## OpenSEO (private, port 3001, volume /app/.wrangler) ##########
# local_noauth is the only self-host mode that runs without Cloudflare Zero Trust
# or the openseo.so billing stack. The service has NO public domain: the Gateway
# below is the only way in, and it requires a login.
AUTH_MODE=local_noauth
# Exposes Railway variables to the Cloudflare Workers runtime (workerd) inside the image.
CLOUDFLARE_INCLUDE_PROCESS_ENV=true
PORT=3001
# vite preview host allow-list. ".railway.app" covers your *.up.railway.app domain
# and Railway's healthcheck host (healthcheck.railway.app). See README for custom domains.
ALLOWED_HOST=.railway.app
# Encrypts stored Google OAuth tokens (Search Console / Analytics). Unused until you add Google keys.
BETTER_AUTH_SECRET=${{secret(48)}}
VITE_SHOW_DEVTOOLS=false
# User-supplied, optional at deploy time. base64 of "your-dataforseo-login:your-api-password"
#   printf 'you@example.com:API_PASSWORD' | base64
# Left empty, the app boots and is healthy; SEO data features stay disabled until it is set.
DATAFORSEO_API_KEY=

# --- Optional, add after deploy (not in the template) ---
# OPENROUTER_API_KEY=        # enables SAM, the in-app AI SEO agent, and AI Visibility prompt suggestions
# OPENROUTER_MODEL=
# CONTEXT_API_KEY=           # enables "Render JavaScript" in site audits
# GOOGLE_CLIENT_ID=          # Google Search Console / Analytics (needs BETTER_AUTH_SECRET, already set)
# GOOGLE_CLIENT_SECRET=
# CRAWLER_ACCESS_SECRET=     # 32+ random chars, for replaying saved Shopify crawler signatures
# OPENSEO_TELEMETRY_DISABLED=1   # opt out of the anonymous usage heartbeat

########## Gateway (public, domain -> port 8080) ##########
PORT=8080
OPENSEO_USERNAME=admin
# Your login password. Generated per deploy; read it from the Gateway service's Variables tab.
OPENSEO_PASSWORD=${{secret(24)}}
OPENSEO_UPSTREAM=${{OpenSEO.RAILWAY_PRIVATE_DOMAIN}}:${{OpenSEO.PORT}}
# CADDYFILE = full contents of gateway/Caddyfile
